# ClipperCartel — production environment template.
#
# Copy this file to .env on the host and fill in real values. Never
# commit the completed .env — it holds the Telegram token, the DB
# password, and the SMTP credentials.
#
# chmod 600 .env after creating it.

# ---------- Application ----------
APP_NAME="ClipperCartel"
APP_URL=https://clippercartel.mgbah.dev
APP_ENV=production
APP_TIMEZONE=Africa/Lagos

# ---------- Database (MySQL / MariaDB on cPanel) ----------
# Naming convention: <cpanel_user>_<project>
DB_HOST=localhost
DB_NAME=iuewrgivrh_clippercartel
DB_USER=iuewrgivrh_cartel
DB_PASS=

# ---------- Security ----------
SESSION_LIFETIME=3600
PASSWORD_HASH_COST=12

# ---------- Email (SMTP) ----------
# Fill when Spacemail credentials are ready.
SMTP_HOST=mail.spacemail.com
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=noreply@clippercartel.com
SMTP_FROM_NAME="ClipperCartel"
CONTACT_TO=
OWNER_EMAIL=

# ---------- Spam protection ----------
# Create at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---------- Telegram (owner notifications) ----------
# Create a bot via @BotFather, paste its token here. Then DM the bot
# once from the owner's phone and run:
#   php database/bootstrap_telegram_chat.php
# to fetch the chat_id, and paste it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---------- Shop details ----------
SHOP_PHONE="+234 916 506 3185"
SHOP_PHONE_E164="+2349165063185"
SHOP_WHATSAPP="+2349165063185"
SHOP_ADDRESS="18 Ada George Road, Port Harcourt, Rivers State, Nigeria"
SHOP_ADDRESS_STREET="18 Ada George Road"
SHOP_ADDRESS_CITY="Port Harcourt"
SHOP_ADDRESS_REGION="Rivers State"
SHOP_ADDRESS_COUNTRY="NG"
SHOP_HOURS="Mon–Sat 09:00–20:00 · Sun closed"
SHOP_HOURS_OPEN="09:00"
SHOP_HOURS_CLOSE="20:00"
SHOP_HOURS_CLOSED_DAYS="Sunday"
SHOP_INSTAGRAM="https://www.instagram.com/clipper_cartel_1"
SHOP_INSTAGRAM_HANDLE="clipper_cartel_1"
SHOP_TIKTOK="https://www.tiktok.com/@clippercartelgmail.com"
SHOP_TIKTOK_HANDLE="clippercartelgmail.com"
SHOP_FACEBOOK="https://www.facebook.com/share/19QDGZdn4B/"
SHOP_SNAPCHAT="https://snapchat.com/t/R9SRDFOw"
SHOP_MAPS_URL="https://maps.google.com/?q=18+Ada+George+Road+Port+Harcourt"
