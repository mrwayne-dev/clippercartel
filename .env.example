# Environment Configuration — clippercartel
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# Database
DB_HOST=localhost
DB_NAME=clippercartel
DB_USER=root
DB_PASS=

# Application
APP_NAME="clippercartel"
APP_URL=http://localhost
APP_ENV=development

# Security
SESSION_LIFETIME=3600
PASSWORD_HASH_COST=12

# Email (SMTP)
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@clippercartel.com
SMTP_FROM_NAME="clippercartel"
