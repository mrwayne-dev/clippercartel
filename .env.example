# Environment Configuration — clippercartel
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# ---------- Application ----------
APP_NAME="ClipperCartel"
APP_URL=https://clippercartel.test
APP_ENV=development
APP_TIMEZONE=Africa/Lagos

# ---------- Database (MySQL) ----------
DB_HOST=localhost
DB_NAME=clippercartel
DB_USER=root
DB_PASS=

# ---------- Security ----------
SESSION_LIFETIME=3600
PASSWORD_HASH_COST=12

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@clippercartel.com
SMTP_FROM_NAME="ClipperCartel"

# Where contact form messages are delivered; falls back to SMTP_USER if blank.
CONTACT_TO=

# ---------- Spam protection ----------
# Cloudflare Turnstile — generate at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---------- Telegram bot (owner notifications) ----------
# Create a bot via @BotFather and paste the token here. Then DM the bot
# once from the owner's phone and run:
#   php database/bootstrap_telegram_chat.php
# to fetch the chat_id, and paste it below.
TELEGRAM_BOT_TOKEN=
TELEGRAM_OWNER_CHAT_ID=

# ---------- Shop details (populated when shop info lands) ----------
SHOP_PHONE="+234 000 000 0000"
SHOP_PHONE_E164="+2340000000000"
SHOP_WHATSAPP="+2340000000000"
SHOP_ADDRESS="Street, City, Region, Country"
SHOP_ADDRESS_STREET=
SHOP_ADDRESS_CITY=
SHOP_ADDRESS_REGION=
SHOP_ADDRESS_COUNTRY="NG"
# Human-readable; shown in footer and the booking widget's default window
SHOP_HOURS="Mon–Sat 09:00–20:00 · Sun closed"
SHOP_HOURS_OPEN="09:00"
SHOP_HOURS_CLOSE="20:00"
SHOP_HOURS_CLOSED_DAYS="Sunday"
SHOP_INSTAGRAM=
SHOP_INSTAGRAM_HANDLE=
SHOP_TIKTOK=
SHOP_TIKTOK_HANDLE=
SHOP_FACEBOOK=
SHOP_SNAPCHAT=
SHOP_MAPS_URL=
