# Environment Configuration — clippercartel
# Copy this file to .env and fill in your credentials
# Never commit .env to version control

# ---------- Application ----------
APP_NAME="ClipperCartel"
APP_URL=https://clippercartel.test
APP_ENV=development
APP_TIMEZONE=Africa/Lagos

# ---------- Database (MySQL) ----------
DB_HOST=localhost
DB_NAME=clippercartel
DB_USER=root
DB_PASS=

# ---------- Security ----------
SESSION_LIFETIME=3600
PASSWORD_HASH_COST=12

# ---------- Email (SMTP) ----------
SMTP_HOST=smtp.gmail.com
SMTP_PORT=587
SMTP_USER=your-email@gmail.com
SMTP_PASS=your-app-password
SMTP_FROM=noreply@clippercartel.com
SMTP_FROM_NAME="ClipperCartel"

# Where contact form messages are delivered; falls back to SMTP_USER if blank.
CONTACT_TO=

# ---------- Spam protection ----------
# Cloudflare Turnstile — generate at https://dash.cloudflare.com/?to=/:account/turnstile
TURNSTILE_SITEKEY=
TURNSTILE_SECRET=

# ---------- WhatsApp (Meta Cloud API) — reserved, wires up in booking phase ----------
WHATSAPP_PHONE_NUMBER_ID=
WHATSAPP_ACCESS_TOKEN=
WHATSAPP_WEBHOOK_VERIFY_TOKEN=
WHATSAPP_BUSINESS_ACCOUNT_ID=

# ---------- Shop details (populated when shop info lands) ----------
SHOP_PHONE="+234 000 000 0000"
SHOP_PHONE_E164="+2340000000000"
SHOP_WHATSAPP="+2340000000000"
SHOP_ADDRESS="Street, City, Region, Country"
SHOP_ADDRESS_STREET=
SHOP_ADDRESS_CITY=
SHOP_ADDRESS_REGION=
SHOP_ADDRESS_COUNTRY="NG"
SHOP_INSTAGRAM=
SHOP_MAPS_URL=
