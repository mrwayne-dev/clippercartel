# clippercartel — Apache Configuration
# Phase 1: SPA fallback, security headers, hotlink block, source lockdown.

Options -Indexes +FollowSymLinks
RewriteEngine On
RewriteBase /

# -------------------------------------------------------------
# Clean URLs — remove .php extension
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-d
RewriteCond %{REQUEST_FILENAME}\.php -f
RewriteRule ^(.*)$ $1.php [L]

# -------------------------------------------------------------
# SPA fallback — route all non-file, non-directory requests to index.php
# so client-side router.js can handle navigation.
# -------------------------------------------------------------
RewriteCond %{REQUEST_FILENAME} !-f
RewriteCond %{REQUEST_FILENAME} !-d
RewriteRule ^(.*)$ index.php [L,QSA]

# -------------------------------------------------------------
# Deny direct access to sensitive files
# -------------------------------------------------------------
<FilesMatch "^(\.env|\.env\..*|\.gitignore|\.gitattributes|\.htaccess|\.editorconfig|composer\.(json|lock)|package(-lock)?\.json|PROJECT_PLAN\.md|ARCHITECTURE\.md|README\.md)$">
    Require all denied
</FilesMatch>

# -------------------------------------------------------------
# Deny access to source directories
# -------------------------------------------------------------
RewriteRule ^(vendor|includes|config|api/includes)/ - [F,L]

# -------------------------------------------------------------
# Hotlink protection — only our own domain may embed our images.
# Direct hits (empty referrer) still allowed so users can right-save
# via the privacy page's download links, feeds work, etc.
# -------------------------------------------------------------
RewriteCond %{HTTP_REFERER} !^$
RewriteCond %{HTTP_REFERER} !^https?://(www\.)?clippercartel\.(com|test) [NC]
RewriteRule \.(jpe?g|png|webp|avif|gif|svg)$ - [F,NC,L]

# -------------------------------------------------------------
# Security headers (every response)
# -------------------------------------------------------------
<IfModule mod_headers.c>
    Header always set X-Content-Type-Options "nosniff"
    Header always set X-Frame-Options "SAMEORIGIN"
    Header always set Referrer-Policy "strict-origin-when-cross-origin"
    Header always set Permissions-Policy "camera=(), microphone=(), geolocation=(), interest-cohort=()"
    Header always set Strict-Transport-Security "max-age=63072000; includeSubDomains; preload" env=HTTPS

    # Content Security Policy.
    #   script-src adds challenges.cloudflare.com for Turnstile (loaded on contact + booking pages only).
    #   frame-src same reason.
    #   style 'unsafe-inline' is required for the inline critical CSS block in index.php.
    #   Loosen img-src if we later serve from a CDN.
    Header always set Content-Security-Policy "default-src 'self'; script-src 'self' https://challenges.cloudflare.com; style-src 'self' 'unsafe-inline'; img-src 'self' data: blob:; font-src 'self' data:; connect-src 'self' https://challenges.cloudflare.com; frame-src https://challenges.cloudflare.com https://www.google.com; frame-ancestors 'self'; base-uri 'self'; form-action 'self'; object-src 'none'; upgrade-insecure-requests"

    # Cache fonts and hashed assets aggressively; HTML not at all.
    <FilesMatch "\.(woff2|woff|ttf|otf)$">
        Header set Cache-Control "public, max-age=31536000, immutable"
    </FilesMatch>
    <FilesMatch "\.(css|js|png|jpg|jpeg|webp|avif|svg|ico)$">
        Header set Cache-Control "public, max-age=2592000"
    </FilesMatch>
    <FilesMatch "\.(php|html)$">
        Header set Cache-Control "no-store, must-revalidate"
    </FilesMatch>
</IfModule>

# -------------------------------------------------------------
# Compression
# -------------------------------------------------------------
<IfModule mod_deflate.c>
    AddOutputFilterByType DEFLATE text/html text/plain text/xml text/css text/javascript application/javascript application/json application/xml image/svg+xml
</IfModule>

# -------------------------------------------------------------
# Custom error pages
# -------------------------------------------------------------
ErrorDocument 404 /index.php
ErrorDocument 403 /index.php
